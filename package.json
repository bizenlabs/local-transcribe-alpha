    "decompress-targz": "^4.1.1",
    "electron-dl": "^4.0.0",
    "electron-fetch": "^1.9.1",
    "electron-json-storage": "^4.6.0",
    "electron-ollama": "^0.1.25",
    "electron-updater": "^6.3.9",
